# AssemblyAI Voice Agent API key
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Application
APP_NAME=VoiceLab
APP_HOST=127.0.0.1
APP_PORT=8000

# Environment
ENVIRONMENT=development
DEBUG=true# Set to a PostgreSQL DSN for production persistence. Leave empty for local SQLite.
# VOICELAB_DATABASE_URL=postgresql://voicelab:password@localhost:5432/voicelab
DB_CONNECT_TIMEOUT=10
