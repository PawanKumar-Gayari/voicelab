APP_NAME=VoiceLab
APP_HOST=0.0.0.0
APP_PORT=8000
ENVIRONMENT=production
DEBUG=false

ASSEMBLYAI_API_KEY=replace_me
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=replace_me
LIVEKIT_API_SECRET=replace_me
GOOGLE_API_KEY=replace_me
VOICELAB_DB_PATH=/app/data/voicelab_state.db

# Production authentication (required)
AUTH_USERNAME=researcher
AUTH_PASSWORD=replace_with_a_long_random_password
AUTH_SECRET=replace_with_at_least_32_random_bytes
AUTH_SESSION_TTL=28800

# PostgreSQL production event store
POSTGRES_DB=voicelab
POSTGRES_USER=voicelab
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
VOICELAB_DATABASE_URL=postgresql://voicelab:CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD@postgres:5432/voicelab
DB_CONNECT_TIMEOUT=10
